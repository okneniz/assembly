# round-trip corpus: cross-built binaries, rebuilds and reports —
# everything is regenerated by `make -C tests rt-cli` / `make -C tests rt-run`
/tests/corpus/

# project-local tools (golangci-lint via make lint/bin/golangci-lint)
/bin/

# compiled binaries
/assembly-server
/cmd/assembly-server/assembly-server
*.exe

# ARM System Register XML — bulky and regenerable via
# `make update-sysreg-data` (then `make gen-sysregs`). The derived Go table
# (arch/arm64/sysregs_generated.go) IS tracked.
arch/arm64/data/sysreg/

# Spike encoding.h — canonical, regenerable via `make update-riscv-csr-data`
# (then `make gen-riscv-csr`). The derived Go table (csr_generated.go) is tracked.
arch/riscv/data/encoding.h

# ARM A64 ISA instruction XML — bulky and regenerable; fetched from the A64 ISA
# Data release (developer.arm.com/documentation/109389) Downloads tab and
# extracted into arch/arm64/data/instr/. The derived Go table
# (arch/arm64/isa_generated.go) IS tracked.
arch/arm64/data/instr/
